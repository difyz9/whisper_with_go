ARG GO_VERSION=1.23.4

FROM --platform=$TARGETPLATFORM golang:${GO_VERSION}-bullseye AS go-dist

FROM --platform=$TARGETPLATFORM ubuntu:22.04 AS whisper-builder

ENV DEBIAN_FRONTEND=noninteractive
ARG WHISPER_CPP_REPO=https://github.com/ggerganov/whisper.cpp.git
ARG WHISPER_CPP_REF=master

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    curl \
    ffmpeg \
    git \
    pkg-config \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone --depth 1 --branch ${WHISPER_CPP_REF} ${WHISPER_CPP_REPO} whisper.cpp && \
    cd whisper.cpp && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build --config Release -j"$(nproc)"

FROM --platform=$TARGETPLATFORM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    ca-certificates \
    curl \
    ffmpeg \
    git \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY --from=go-dist /usr/local/go /usr/local/go
COPY --from=whisper-builder /opt/whisper.cpp /usr/local/whisper.cpp
COPY --from=whisper-builder /opt/whisper.cpp/include/ /usr/local/include/
COPY --from=whisper-builder /opt/whisper.cpp/ggml/include/ /usr/local/include/
COPY --from=whisper-builder /opt/whisper.cpp/build/src/libwhisper.so /usr/local/lib/libwhisper.so
COPY --from=whisper-builder /opt/whisper.cpp/build/ggml/src/libggml.so /usr/local/lib/libggml.so
COPY --from=whisper-builder /opt/whisper.cpp/build/ggml/src/libggml-base.so /usr/local/lib/libggml-base.so
COPY --from=whisper-builder /opt/whisper.cpp/build/ggml/src/libggml-cpu.so /usr/local/lib/libggml-cpu.so

RUN useradd -m -u 1000 whisper && \
    mkdir -p /workspace /models /tmp/whisper /go/pkg/mod /root/.cache/go-build && \
    chown -R whisper:whisper /workspace /models /tmp/whisper && \
    ln -sf /usr/local/lib/libwhisper.so /usr/local/lib/libwhisper.so.1 && \
    ln -sf /usr/local/lib/libggml.so /usr/local/lib/libggml.so.0 && \
    ln -sf /usr/local/lib/libggml-base.so /usr/local/lib/libggml-base.so.0 && \
    ln -sf /usr/local/lib/libggml-cpu.so /usr/local/lib/libggml-cpu.so.0 && \
    printf '/usr/local/lib\n' > /etc/ld.so.conf.d/whisper.conf && \
    ldconfig

ENV PATH=/usr/local/go/bin:${PATH}
ENV CGO_ENABLED=1
ENV CGO_CFLAGS=-I/usr/local/include
ENV CGO_LDFLAGS=-L/usr/local/lib
ENV LD_LIBRARY_PATH=/usr/local/lib
ENV WHISPER_CPP_PATH=/usr/local/whisper.cpp
ENV GOMODCACHE=/go/pkg/mod
ENV GOCACHE=/root/.cache/go-build

WORKDIR /workspace

CMD ["bash"]


# 如果是本地先验证，先只测单平台更稳，比如：
# docker buildx build --platform linux/amd64 -f Dockerfile.base .
# docker buildx build --platform linux/arm64 -f Dockerfile.base .

# docker build --platform linux/arm64 -f Dockerfile.base -t difyz9/whisper-go-base:v0.0.2 .
# sudo docker build --platform linux/amd64 -f Dockerfile.base -t difyz9/whisper-go-base:v0.0.2 .