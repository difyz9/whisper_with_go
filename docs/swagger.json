{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "基于 Gin 和 whisper.cpp 的语音转文字 API 服务。",
        "title": "Whisper API Server",
        "contact": {
            "name": "API Support",
            "url": "https://github.com/difyz9/whisper_with_go"
        },
        "license": {
            "name": "MIT"
        },
        "version": "1.0.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/download/{filename}": {
            "get": {
                "description": "下载转录生成的字幕或文本文件",
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "Whisper"
                ],
                "summary": "下载输出文件",
                "parameters": [
                    {
                        "type": "string",
                        "description": "文件名",
                        "name": "filename",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/whisper_with_go_internal_model.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/whisper_with_go_internal_model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/transcribe": {
            "post": {
                "description": "上传音频文件并转录为文本",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Whisper"
                ],
                "summary": "转录音频",
                "parameters": [
                    {
                        "type": "file",
                        "description": "音频文件",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "default": "auto",
                        "description": "语言代码 (auto, zh, en, etc.)",
                        "name": "language",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "default": "json",
                        "description": "输出格式 (json, srt, txt)",
                        "name": "output_type",
                        "in": "formData"
                    },
                    {
                        "type": "boolean",
                        "default": false,
                        "description": "是否翻译为英文",
                        "name": "translate",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/whisper_with_go_internal_model.TranscribeSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/whisper_with_go_internal_model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/whisper_with_go_internal_model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "检查服务是否正常运行",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/whisper_with_go_internal_model.HealthCheckResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "whisper_with_go_internal_model.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid request"
                },
                "message": {
                    "type": "string",
                    "example": "参数错误"
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "whisper_with_go_internal_model.HealthCheckResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                },
                "time": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            }
        },
        "whisper_with_go_internal_model.Segment": {
            "type": "object",
            "properties": {
                "end": {
                    "description": "结束时间（秒）",
                    "type": "number"
                },
                "index": {
                    "type": "integer"
                },
                "start": {
                    "description": "开始时间（秒）",
                    "type": "number"
                },
                "text": {
                    "description": "文本内容",
                    "type": "string"
                }
            }
        },
        "whisper_with_go_internal_model.TranscribeResponse": {
            "type": "object",
            "properties": {
                "duration_seconds": {
                    "type": "number"
                },
                "filename": {
                    "type": "string"
                },
                "language": {
                    "type": "string"
                },
                "output_file": {
                    "type": "string"
                },
                "process_time_seconds": {
                    "type": "number"
                },
                "segments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/whisper_with_go_internal_model.Segment"
                    }
                },
                "task_id": {
                    "type": "string"
                },
                "text": {
                    "type": "string"
                }
            }
        },
        "whisper_with_go_internal_model.TranscribeSuccessResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/whisper_with_go_internal_model.TranscribeResponse"
                },
                "message": {
                    "type": "string",
                    "example": "转录成功"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        }
    }
}